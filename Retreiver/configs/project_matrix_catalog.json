{
  "schema_version": 1,
  "matrix": {
    "chunkers": [
      "entity_heuristic_w6",
      "entity_heuristic_w5",
      "entity_heuristic_w4",
      "Heading_sections_l2",
      "fixed_tok1200_ov150"
    ],
    "embeddings": [
      "jina_v3",
      "gte_multilingual_base",
      "openai_text-embedding-3-large"
    ],
    "vector_stores": [
      "Qdrant",
      "PGVector",
      "Weaviate",
      "FAISS"
    ],
    "rerankers": [
      "Amazon Rerank v1",
      "Qwen3:4B Rerank",
      "bge-reranker-base"
    ]
  },
  "techniques": {
    "chunkers": {
      "entity_heuristic_w6": {
        "module": "source.services.project_chunking",
        "callable": "entity_heuristic_chunking",
        "params": {
          "window_size": 6
        }
      },
      "entity_heuristic_w5": {
        "module": "source.services.project_chunking",
        "callable": "entity_heuristic_chunking",
        "params": {
          "window_size": 5
        }
      },
      "entity_heuristic_w4": {
        "module": "source.services.project_chunking",
        "callable": "entity_heuristic_chunking",
        "params": {
          "window_size": 4
        }
      },
      "Heading_sections_l2": {
        "module": "source.services.project_chunking",
        "callable": "heading_sections_chunking",
        "params": {
          "level": 2
        }
      },
      "fixed_tok1200_ov150": {
        "module": "source.services.project_chunking",
        "callable": "fixed_token_chunks",
        "params": {
          "chunk_tokens": 1200,
          "overlap_tokens": 150
        }
      }
    },
    "embeddings": {
      "jina_v3": {
        "adapter": "remote_http",
        "dimensions": 1024,
        "license": "open_source",
        "execution_location": "vm_only",
        "endpoint_env": "JINA_EMBEDDING_URL",
        "api_key_env": "JINA_API_KEY",
        "batch_size": 32
      },
      "gte_multilingual_base": {
        "adapter": "remote_http",
        "dimensions": 768,
        "license": "open_source",
        "execution_location": "vm_only",
        "endpoint_env": "GTE_EMBEDDING_URL",
        "api_key_env": "HF_TOKEN",
        "batch_size": 32
      },
      "openai_text-embedding-3-large": {
        "adapter": "openai",
        "dimensions": 3072,
        "license": "commercial",
        "api_key_env": "OPENAI_API_KEY",
        "batch_size": 32
      }
    },
    "vector_stores": {
      "Qdrant": {
        "adapter": "qdrant",
        "provider_ready_env": "QDRANT_URL",
        "url_env": "QDRANT_URL",
        "api_key_env": "QDRANT_API_KEY"
      },
      "PGVector": {
        "adapter": "pgvector",
        "provider_ready_env": "PGVECTOR_DSN",
        "dsn_env": "PGVECTOR_DSN"
      },
      "Weaviate": {
        "adapter": "weaviate",
        "provider_ready_env": "WEAVIATE_URL",
        "url_env": "WEAVIATE_URL"
      },
      "FAISS": {
        "adapter": "faiss",
        "execution_location": "in_process",
        "index_type": "HNSW",
        "hnsw_m": 16,
        "ef_construction": 100,
        "ef_search": 64
      }
    },
    "rerankers": {
      "Amazon Rerank v1": {
        "adapter": "amazon_bedrock",
        "license": "commercial",
        "provider_ready_env": "AWS_REGION",
        "model_id_env": "AMAZON_RERANK_MODEL_ID"
      },
      "Qwen3:4B Rerank": {
        "adapter": "remote_http",
        "license": "open_source",
        "execution_location": "vm_only",
        "endpoint_env": "QWEN_RERANK_URL",
        "api_key_env": "QWEN_API_KEY",
        "model": "Qwen3:4B Rerank"
      },
      "bge-reranker-base": {
        "adapter": "remote_http",
        "license": "open_source",
        "execution_location": "vm_only",
        "endpoint_env": "BGE_RERANK_URL",
        "api_key_env": "HF_TOKEN",
        "model": "bge-reranker-base"
      }
    }
  }
}
