# WNS Benchmark Environment
# Copy this file to .env and fill values on your work laptop.
# Do not commit or share .env with real secrets.

# -----------------------------
# Run mode
# -----------------------------
# local_offline_fallback = no real APIs, safe smoke testing
# provider_real = use real embedding/vector/rerank adapters once implemented
WNS_BENCHMARK_MODE=local_offline_fallback

# -----------------------------
# Embeddings
# -----------------------------
# Needed for openai_text-embedding-3-large
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Open-source embeddings should run on WNS-provided VM/remote service, not laptop CPU.
# Point these at the VM embedding endpoints once IT/WNS gives them.
# No Jina API key is needed when Jina is self-hosted on the VM.
JINA_EMBEDDING_MODE=vm_remote
JINA_EMBEDDING_URL=
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3

GTE_EMBEDDING_MODE=vm_remote
GTE_EMBEDDING_URL=
# Needed only if the VM/Hugging Face endpoint requires auth.
HF_TOKEN=
GTE_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base

# -----------------------------
# Vector DB services, Docker local defaults
# -----------------------------
# Start with:
# docker compose -f docker-compose.benchmark.yml up -d qdrant postgres-pgvector weaviate
QDRANT_URL=http://127.0.0.1:5001
# Only needed for Qdrant Cloud or auth-enabled Qdrant
QDRANT_API_KEY=

PGVECTOR_DSN=postgresql://wns:wns_password@127.0.0.1:5003/wns_benchmark
# Optional alias if libraries expect DATABASE_URL
DATABASE_URL=postgresql://wns:wns_password@127.0.0.1:5003/wns_benchmark

WEAVIATE_URL=http://127.0.0.1:5004
# Only needed if Weaviate auth is enabled
WEAVIATE_API_KEY=

# -----------------------------
# Rerankers
# -----------------------------
# Amazon Rerank v1 / Bedrock, needed only for Amazon Rerank
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional alias if your shell/tooling uses it
AWS_DEFAULT_REGION=us-east-1
# Placeholder model id, confirm the exact Bedrock rerank model id enabled in your AWS account.
AMAZON_RERANK_MODEL_ID=

# BGE reranker, local open-source default
BGE_RERANKER_MODEL=BAAI/bge-reranker-base
BGE_RERANKER_DEVICE=cpu

# Qwen3:4B Rerank, do NOT run locally on work laptop if underpowered.
# Point this at the VM-hosted reranker endpoint.
QWEN_RERANK_URL=
# Only needed if the VM/hosted endpoint requires auth
QWEN_API_KEY=
QWEN_RERANK_MODEL=Qwen3-4B-Rerank
QWEN_RERANK_LOCATION=vm_remote

# -----------------------------
# Benchmark safety/performance
# -----------------------------
# Enable once provider adapters are added, to avoid repeated paid calls.
EMBEDDING_CACHE_DIR=.cache/embeddings
RERANK_CACHE_DIR=.cache/rerank
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=3
